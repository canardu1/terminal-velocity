{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terminal Velocity",
  "version": "0.1.0",
  "identifier": "com.termilal.desktop",
  "build": {
    "beforeDevCommand": "",
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Terminal Velocity",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "fullscreen": false,
        "resizable": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/askpass.sh": "askpass.sh",
      "resources/termilal-auth": "termilal-auth"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
